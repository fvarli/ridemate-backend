APP_NAME=RideMate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_RELEASE=dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ridemate
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Database, not file. FileStore::increment() is an unlocked read-modify-write and
# the rate limiter relies on it for every hit after the first, so parallel
# requests lose hits and more of them get through than the limit allows.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# How email is delivered, if RIDEMATE_EMAIL_DRIVER says it is delivered at all.
# `log` is safe here and CATASTROPHIC in production: it writes the passcode to a
# file and reports success, so delivery looks fine and nobody receives anything.
# LaravelMailEmailSender refuses to resolve on `log` or `array` when
# APP_ENV=production, so that mistake stops at boot rather than in an incident.
#
# The pilot deployment uses Zoho Mail's EU endpoint, and the region is
# load-bearing: smtp.zoho.com answers SMTP 535 for this account, which reads as
# a bad password and sends an operator hunting for the wrong thing. A null
# scheme on port 587 is STARTTLS, which is the verified combination.
#
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=null
#   MAIL_HOST=smtp.zoho.eu
#   MAIL_PORT=587
#   MAIL_USERNAME=<the sender mailbox>
#   MAIL_PASSWORD=<a Zoho App Password — never committed, never logged>
#   MAIL_FROM_ADDRESS=<the sender mailbox>
#
# The sender identity is a shared pilot mailbox, not a RideMate domain. A
# RideMate sender and its DNS are production-hardening work this pilot has not
# done.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Passcode delivery. `local_echo` writes the code to
# storage/app/local-otp/latest.txt and refuses to run outside APP_ENV=local.
# Any real deployment leaves this unset, which fails loudly rather than
# discarding passcodes: production sign-in is not operational until an SMS
# adapter is configured.
RIDEMATE_SMS_DRIVER=local_echo

# Email delivery. `null` refuses to send and is the default; `laravel_mail`
# hands the passcode to Laravel's mail stack, which MAIL_* above points at.
#
# Two keys, two questions: this one decides WHETHER RideMate delivers email,
# MAIL_MAILER decides HOW. Until this is set to `laravel_mail`, no MAIL_*
# value can route a passcode anywhere — which is why the stock `MAIL_MAILER=log`
# above is harmless.
#
# Left commented so the key is documented without overriding the code default
# it already matches. A deployment that means to send email sets it explicitly.
# RIDEMATE_EMAIL_DRIVER=laravel_mail
